# Voyage Backend — example .env
# Copy to .env and fill in your values

# API key — anyone with this key can read your email via the API
# Generate with: openssl rand -hex 32
# Leave empty to disable auth (trusted local network only)
VOYAGE_API_KEY=change-me-to-a-long-random-secret

# Your local mail paths (required)
VOYAGE_MAIL_DIR=/home/you/.mail
VOYAGE_NOTMUCH_CONFIG=/home/you/.notmuch-config

# Server
VOYAGE_PORT=8181

# CORS — comma-separated origins allowed to call the API
# For Tailscale: use your device's Tailscale IP, e.g. http://100.x.x.x:1234
VOYAGE_ALLOWED_ORIGINS=http://localhost:1234

# Voyage data (defaults work fine, change if you want a different location)
# VOYAGE_TRIPS_DB=./trips.json
# VOYAGE_CLASSIFIERS=./configs/classifiers.yaml
# VOYAGE_SYNC_CMD=./scripts/sync-mail.sh
