# Copy to tests/hurl/.env and fill with your deployed backend details.
# This file is gitignored so you can keep real secrets/URLs local.

BASE_URL=https://your-voyage-backend.example.com
API_KEY=replace-with-your-real-api-key

# Optional query used to find at least one message for flow tests.
# Keep broad so at least one message is returned.
SEARCH_QUERY=*

# Set to 1 to run mutating trip flow (create/associate/delete).
# Default 0 runs non-mutating checks only.
RUN_MUTATION=0
